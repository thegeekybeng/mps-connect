    "better-sqlite3":                            "^12.11.1",
    "bullmq":                                    "^6.1.0",
    "clamscan":                                  "^2.2.1",
    "cookie-parser":                             "^1.4.7",
    "express":                                   "^4.18.2",
    "form-data":                                 "^4.0.0",
    "ioredis":                                   "^5.4.1",
    "jose":                                      "^5.0.0",
    "multer":                                    "^1.4.5-lts.1",
    "pg":                                        "^8.11.3",
