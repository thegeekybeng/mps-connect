# MPS-Connect — Environment Variables
# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-in-production

# ── Authentication ────────────────────────────────────────────
# JWT secret — MUST be min 32 random chars in production
JWT_SECRET=change-this-in-production-must-be-32-chars-min

# Staff access code — used by the demo auth flow
VITE_STAFF_ACCESS_CODE=change-me

# ── AI Inference ──────────────────────────────────────────────
# Ollama chat endpoint (server-side proxy only — never exposed to browser)
OLLAMA_ENDPOINT=http://localhost:11434/api/chat

# Model name (must be pulled in Ollama first)
AI_MODEL=gemma4:e2b

# AI kill switch — emergency AI disable (IMDA Agentic AI Framework Dim.1)
# Set to 'true' to disable all AI endpoints immediately
AI_KILL_SWITCH=false

# ── Application ───────────────────────────────────────────────
# Public URL (used for CORS allowlist and upload link generation)
APP_URL=http://localhost:3080

# Node environment
NODE_ENV=production
