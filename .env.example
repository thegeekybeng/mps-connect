# MPS-Connect — Environment Variables
# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# Staff portal access code — set something only you know
VITE_STAFF_ACCESS_CODE=change-me

# Ollama inference endpoint (proxied via nginx)
VITE_OLLAMA_HOST=/ollama-api
VITE_OLLAMA_MODEL=gemma4:e2b

# Speech bridge endpoint (proxied via nginx)
VITE_SPEECH_HOST=/ai-speech
